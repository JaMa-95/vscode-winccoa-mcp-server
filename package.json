{
  "name": "winccoa-mcp-server",
  "displayName": "WinCC OA MCP Server",
  "description": "Model Context Protocol server for WinCC OA - enables AI assistants to interact with WinCC OA projects",
  "publisher": "RichardJanisch",
  "version": "0.2.0",
  "author": "Richard Janisch",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "wincc",
    "wincc oa",
    "scada",
    "mcp",
    "model context protocol",
    "ai",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "winccoa.mcp.setup",
        "title": "WinCC OA: Setup MCP Server"
      },
      {
        "command": "winccoa.mcp.start",
        "title": "WinCC OA: Start MCP Server"
      },
      {
        "command": "winccoa.mcp.stop",
        "title": "WinCC OA: Stop MCP Server"
      },
      {
        "command": "winccoa.mcp.restart",
        "title": "WinCC OA: Restart MCP Server"
      },
      {
        "command": "winccoa.mcp.showLogs",
        "title": "WinCC OA: Show MCP Logs"
      },
      {
        "command": "winccoa.mcp.diagnostics",
        "title": "WinCC OA: MCP Diagnostics"
      },
      {
        "command": "winccoa.mcp.updateConfig",
        "title": "WinCC OA: Update MCP Configuration"
      },
      {
        "command": "winccoa.mcp.generateToken",
        "title": "WinCC OA: Generate MCP Token"
      }
    ]
  },
  "scripts": {
    "build": "tsc --build",
    "compile": "tsc --build",
    "prepublishOnly": "npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:md": "prettier --write \"**/*.md\"",
    "format:md:check": "prettier --check \"**/*.md\"",
    "style-check": "npm run lint && npm run format:check && npm run lint:md && npm run format:md:check",
    "style-fix": "npm run lint:fix && npm run format && npm run lint:md:fix && npm run format:md",
    "test": "npm run compile && node ./dist/test/runTest.js",
    "test:unit": "npm run compile && npx mocha --ui tdd dist/test/unit/**/*.test.js",
    "test:integration": "npm run compile && npx mocha --ui tdd dist/test/integration/**/*.test.js",
    "test:watch": "npx mocha --watch --ui tdd --watch-files dist/**/*.js dist/test/**/*.test.js",
    "ci:integration": "npm ci && npm run test:integration",
    "watch": "tsc --build --watch",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.6",
    "@types/node": "^24.10.1",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^3.7.1",
    "chai": "^6.2.2",
    "eslint": "^8.50.0",
    "glob": "^13.0.0",
    "markdownlint-cli": "^0.36.0",
    "mocha": "^11.7.5",
    "prettier": "^2.8.8",
    "sinon": "^21.0.1",
    "typescript": "^5.2.0",
    "vscode-test": "^1.6.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "simple-git": "^3.30.0"
  }
}
